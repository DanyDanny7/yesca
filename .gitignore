# Godot 4
.godot/
/android/
# export_presets.cfg SI se versiona: sin el, un clon limpio no puede
# reconstruir el APK. Regla que no se puede romper: NUNCA meter ahi la
# contrasena de la keystore de publicacion. Godot la escribe sola si se
# configura desde el editor, asi que hay que revisarlo antes de commitear.
*.translation

# Exports
/build/
/exports/
*.apk
*.aab
*.keystore
*.jks

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# arte_exportado/ SI se versiona, aunque sea generado. Sin el, quien abre este
# repo no ve ni una imagen del juego: todo el arte es codigo. Quien vaya a
# redibujar necesita ver lo que hay antes de sustituirlo, y no puede depender
# de instalar Godot para conseguirlo. Pesa 115 KB.
#
# Del APK si esta excluido, en export_presets.cfg: alli si sobra.

# Paso intermedio del troceado de fondos: lo rehace tools/separar_fondos.py.
/entregas/*/_split/
