; Motor: Godot 4.7 — ver contexto/00-decisiones.md
config_version=5

[application]

config/name="Cadena"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; Resolución base vertical. Con stretch canvas_items + expand, esto es un
; MÍNIMO: en pantallas más alargadas el viewport crece en vez de deformarse.
window/size/viewport_width=720
window/size/viewport_height=1280
; Solo afecta a la ventana del editor en escritorio, no al teléfono.
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[debug]

; Godot escribe su propio registro a user://logs/godot.log. En escritorio ya lo
; hace; activarlo explicitamente es lo que lo lleva tambien al telefono, donde
; no hay consola a la vista. Ahi aparecen los errores de script y del motor,
; que las migas de pan de Diagnostico no pueden ver.
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[input_devices]

; Hace que el clic del ratón genere eventos táctiles, para que el mismo código
; de input sirva en el editor y en el teléfono sin ramas.
pointing/emulate_touch_from_mouse=true

[rendering]

; Forward Mobile (Vulkan nativo), NO gl_compatibility.
;
; La eleccion original fue compatibility por ser "lo seguro en gama baja", y
; resulto ser justo lo contrario en el telefono de pruebas. Un Galaxy A56 lleva
; una GPU Samsung Xclipse 540, que no tiene OpenGL nativo: Android le sirve
; OpenGL ES traducido a Vulkan mediante ANGLE. El registro del propio juego lo
; delato:
;
;   gpu=ANGLE ((Samsung Xclipse 540) on Vulkan 1.3.279) driver=OpenGL ES 3.2
;
; Es decir, el juego corria sobre OpenGL emulado sobre Vulkan. Se cerraba con
; 60 fps clavados, memoria plana y sin picos: un fallo de la capa de traduccion,
; no de carga. Con Forward Mobile se habla Vulkan directamente y esa capa
; desaparece.
;
; El precio: Vulkan es obligatorio, asi que quedan fuera dispositivos muy
; antiguos que solo tengan OpenGL ES. A cambio funciona en el telefono real que
; tenemos delante.
;
; Escritorio y movil usan el MISMO renderizador a proposito. Tenerlos distintos
; significa que lo que se prueba en el PC no es lo que corre en el telefono, y
; esa divergencia es exactamente la que costo tres builds y varias horas.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.051, 0.051, 0.071, 1)
; Godot exige ETC2/ASTC para exportar a Android. Aquí no hay ni una textura
; (todo se dibuja con _draw), así que es puro requisito formal.
textures/vram_compression/import_etc2_astc=true

